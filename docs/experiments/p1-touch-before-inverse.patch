 // Pass 1, phase A for thread t: the first group of the range is normalised
 // with carry-in 0 and kept as unweighted digits; the others are completed.
+// EXPERIMENT (AHN_EXP_TOUCH=1): read each group into L1 before its inverse stages; the read
+// is charged to "p1 phase b". Not for merging.
+static int exp_touch = -1;
+static void touch_group(neon_state *st, double *d, uint32_t g) {
+    if (exp_touch < 0) exp_touch = getenv("AHN_EXP_TOUCH") != NULL;
+    if (!exp_touch) return;
+    const char *b = (const char *)d + g * 128;
+    uint64_t acc = 0;
+    for (uint32_t r = 0; r < st->R; r++) {
+        const uint64_t *q = (const uint64_t *)(b + r * st->rowstride);
+        acc += q[0] ^ q[8];
+    }
+    __asm__ volatile("" ::"r"(acc));
+}
