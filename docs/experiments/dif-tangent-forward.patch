+// One tangent-form record (TAN_NSCAL order, see gen/gen_kernels.py) from the
+// input scales c[0..p-1] (c[0] = 1) and tangents tau[1..p-1].
+static void tan_record(uint32_t p, const double *c, const double *tau, double *o) {
+    for (uint32_t t = 1; t < p; t++) o[t - 1] = tau[t];
+    if (p == 2) {
+        o[1] = c[1];
+    } else if (p == 3) {
+        o[2] = c[2] / c[1];
+        o[3] = c[1] * -0.5;
+        o[4] = c[1] * 0.86602540378443864676;
+        o[5] = c[1];
+    } else if (p == 4) {
+        o[3] = c[2];
+        o[4] = c[3] / c[1];
+        o[5] = c[1];
+    } else {
+        o[7] = c[4];
+        o[8] = c[5] / c[1];
+        o[9] = c[6] / c[2];
